# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://project-5583295336911612869-default-rtdb.europe-west1.firebasedatabase.app

# Mesomb Payment API Credentials
# Get these from your Mesomb dashboard: https://mesomb.hachther.com
MESOMB_APPLICATION_KEY=your_mesomb_application_key_here
MESOMB_ACCESS_KEY=your_mesomb_access_key_here
MESOMB_SECRET_KEY=your_mesomb_secret_key_here

# Vote Configuration
NEXT_PUBLIC_VOTE_PRICE=105

# Admin Configuration (optional)
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Firebase Proxy Configuration (for Orange network users)
# Set to your proxy server URL if Firebase is blocked on certain networks
NEXT_PUBLIC_FIREBASE_PROXY_URL=https://35.222.208.69:3000
NEXT_PUBLIC_ENABLE_PROXY=true
