NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://project-5583295336911612869-default-rtdb.europe-west1.firebasedatabase.app

# Mesomb Payment API Credentials
# Get these from your Mesomb dashboard: https://mesomb.hachther.com
MESOMB_APPLICATION_KEY=a4120748a7093365013b04a8f42bdd24f299936b
MESOMB_ACCESS_KEY=fe3efd4c-cb89-45ef-a18b-d831cf25d1ea
