# Vote Configuration
NEXT_PUBLIC_VOTE_PRICE=110

# Admin Configuration (optional)
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Firebase Proxy Configuration (for Orange network users)
# Set to your proxy server URL if Firebase is blocked on certain networks
NEXT_PUBLIC_FIREBASE_PROXY_URL=https://35.222.208.69:3000
NEXT_PUBLIC_ENABLE_PROXY=true

# Appwrite Configuration (Failover Backend)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DB_ID=your_database_id
NEXT_PUBLIC_APPWRITE_CANDIDATES_COLLECTION=candidates
NEXT_PUBLIC_APPWRITE_CATEGORIES_COLLECTION=categories
NEXT_PUBLIC_APPWRITE_CANDIDATE_CATEGORIES_COLLECTION=candidateCategories
NEXT_PUBLIC_APPWRITE_VOTES_COLLECTION=votes
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION=users

# Hybrid Database Configuration (Optimized for Performance)
NEXT_PUBLIC_FAILOVER_TIMEOUT_MS=1500
NEXT_PUBLIC_ENABLE_FAILOVER=true
