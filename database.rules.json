{
    "rules": {
        ".read": "auth == null",
        ".write": "auth == null",
        "candidates": {
            ".read": true,
            ".write": false,
            "$candidateId": {
                "votes": {
                    ".write": true
                },
                "percentage": {
                    ".write": true
                }
            }
        },
        "categories": {
            ".read": true,
            ".write": false
        },
        "candidateCategories": {
            ".read": true,
            ".write": false
        },
        "transactions": {
            ".read": true,
            ".write": true,
            ".indexOn": [
                "mesombReference"
            ]
        },
        "votes": {
            ".read": true,
            ".write": true
        },
        "webhookLogs": {
            ".read": true,
            ".write": true
        },
        "withdrawals": {
            ".read": "auth != null",
            ".write": "auth != null"
        }
    }
}