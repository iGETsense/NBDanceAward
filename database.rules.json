{
    "rules": {
        ".read": "auth == null",
        ".write": "auth == null",
        "issues": {
            ".read": "auth != null",
            ".write": true
        },
        "candidates": {
            ".read": true,
            ".write": false,
            "$candidateId": {
                "votes": {
                    ".write": true
                },
                "percentage": {
                    ".write": true
                }
            }
        },
        "categories": {
            ".read": true,
            ".write": false
        },
        "candidateCategories": {
            ".read": true,
            ".write": false
        },
        "transactions": {
            ".read": true,
            ".write": true,
            ".indexOn": [
                "mesombReference",
                "createdAt"
            ],
            "$transactionId": {
                ".validate": "newData.hasChildren(['id', 'candidateId', 'voteCount', 'phoneNumber', 'paymentMethod', 'operator', 'amount', 'status'])"
            }
        },
        "votes": {
            ".read": true,
            ".write": true
        },
        "withdrawals": {
            ".read": "auth != null",
            ".write": "auth != null"
        }
    }
}